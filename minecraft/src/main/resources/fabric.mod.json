{
  "schemaVersion": 1,
  "id": "eurybium",
  "version": "${version}",
  "name": "Eurybium",
  "description": "A modular Hypixel SkyBlock client mod.",
  "environment": "client",
  "entrypoints": {
    "client": ["github.businessdirt.eurybium.EurybiumModLoader"]
  },
  "mixins": ["eurybium.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-language-kotlin": ">=${fabric_kotlin}",
    "fabric-api": ">=${fabric_api}",
    "universalcraft": "*",
    "minecraft": "${minecraft}",
    "java": ">=25"
  }
}
